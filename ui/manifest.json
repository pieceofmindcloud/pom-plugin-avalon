{
  "schema": "pom-plugin-ui/v1",
  "plugin_code": "avalon",
  "lifecycle": "resident",
  "icon_image": "ui/icon.png",
  "description": {
    "en": "Avalon for Qwen3.8-Flash-Next only: a fast llama.cpp fork that runs this one model (experts in RAM, a GPU expert cache, MTP) on NVIDIA and AMD cards. It runs no other model: download Qwen3.8-Flash-Next-Avalon-GGUF from Hugging Face (freriadoc) first.",
    "pt-BR": "Avalon só para o Qwen3.8-Flash-Next: um fork rápido do llama.cpp que roda apenas este modelo (experts na RAM, cache de experts na GPU, MTP) em placas NVIDIA e AMD. Não roda nenhum outro modelo: baixe antes o Qwen3.8-Flash-Next-Avalon-GGUF do Hugging Face (freriadoc)."
  },
  "screenshots": [
    "docs/screenshots/main.png"
  ],
  "documentation": {
    "guides": [
      {
        "id": "getting-started",
        "title": {
          "en": "Getting started",
          "pt-BR": "Primeiros passos"
        },
        "asset": "docs/getting-started.md"
      }
    ],
    "reference": []
  },
  "menu": [
    {
      "id": "avalon",
      "label": {
        "en": "Avalon · Qwen3.8-Flash-Next",
        "pt-BR": "Avalon · Qwen3.8-Flash-Next"
      },
      "icon": "cpu",
      "to": "/main"
    }
  ],
  "routes": [
    {
      "path": "/main",
      "screen": "main",
      "full_bleed": false
    }
  ],
  "screens": {
    "main": {
      "module": "ui/screens.js",
      "export": "main",
      "styles": [
        "ui/plugin.css"
      ]
    }
  },
  "i18n": {
    "en": "i18n/en.json",
    "pt-BR": "i18n/pt-BR.json"
  },
  "development": {
    "rebuild": [
      {
        "run": [
          "scripts/dev-ui.sh"
        ],
        "os": [
          "linux",
          "macos"
        ]
      }
    ]
  },
  "assets": [
    "ui/screens.js",
    "ui/plugin.css",
    "ui/icon.png",
    "i18n/en.json",
    "i18n/pt-BR.json",
    "docs/getting-started.md"
  ]
